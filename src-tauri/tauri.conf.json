{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "freq",
  "version": "0.1.0",
  "identifier": "com.souchy.glitter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:6789",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run start"
  },
  "app": {
    "windows": [
      {
        "title": "Freq",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://i.ytimg.com https://img.youtube.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
